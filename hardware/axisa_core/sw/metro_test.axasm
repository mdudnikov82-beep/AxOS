    METRO ACCEPT, N4, N1, N0, N3
    ADD N7, N7, N4
    ADDI N6, N6, -1
    BNE N6, N0, rate0
    STORE N7, N0, 0x400
# ACCEPT x 2000: w = 0: never accept, even when r = 0 (the testbench forces the LFSR to 0)
