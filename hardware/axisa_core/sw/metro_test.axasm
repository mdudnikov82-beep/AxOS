# WEIGHT: random
    ADDI N1, N0, 499
    SLLI N1, N1, 11
    ORI N1, N1, 289
    SLLI N1, N1, 10
    ORI N1, N1, 663
    ADDI N2, N0, 1521
    SLLI N2, N2, 11
    ORI N2, N2, 23
    SLLI N2, N2, 10
    ORI N2, N2, 547
    ADDI N3, N0, 508
    SLLI N3, N3, 11
    ORI N3, N3, 0
    SLLI N3, N3, 10
    ORI N3, N3, 0
    METRO WEIGHT, N3, N1, N2, N3   # nd == beta
    STORE N3, N0, 0x38C
# ACCEPT x 2000: w = 1: always accept
    ADDI N1, N0, 1528
    SLLI N1, N1, 11
    ORI N1, N1, 0
    SLLI N1, N1, 10
    ORI N1, N1, 0
    ADDI N3, N0, 508
    SLLI N3, N3, 11
    ORI N3, N3, 0
    SLLI N3, N3, 10
    ORI N3, N3, 0
    ADDI N6, N0, 2000
    ADDI N7, N0, 0
