# AxISA traps: external IRQ arriving exactly on QMEASURE's terminal
# cycle (see cpu_core.v's own `any_trap` comment - the same class of
# same-cycle race trap_irq_stall.axasm/trap_irq_qhad.axasm already
# proved for LOAD/STORE and QHAD, now for the new, much longer
# qm-sequencer). Bootstrap idiom mirrors trap_irq_qhad.axasm exactly.
#
# Reuses qmeasure_test_p1.axasm's own degenerate P0=1.0 setup so the
# expected R-bank results are known exactly (no need to predict the
# LFSR draw in this test) - the testbench pulses irq_in exactly on the
# cycle dut.qm_state_r==QM_W7 (terminal write cycle, the highest-risk
# same-cycle race). If cpu_core.v's any_trap fix is correct, the trap
# is deferred until word index 10 (addr 0x28, the plain ADDI right
# after QMEASURE) - NOT taken against QMEASURE's own address (0x24) -
# and QMEASURE's own results (r0, n1) must be the correct, uncorrupted
# values, proving the whole ~96-cycle sequence completed for real
# before the trap was allowed to land.
    ADDI N1, N0, 1
    MTSIE N1
    ADDI N1, N0, 1
    MTSMODE N1
    ADDI N1, N0, 0x1C       # continue's address (word index 7)
    MTEPC N1
    RFT

continue:
    ADDI R0, R0, 0x3F80     # word index 7, addr 0x1C
    SLLI R0, R0, 16          # word index 8, addr 0x20 - r0 = 1.0f (amp0 Re)
    QMEASURE 0, N1            # word index 9, addr 0x24 - irq_in pulses on its QM_W7 cycle
    ADDI N6, N0, 1           # word index 10, addr 0x28 - must NOT commit before the deferred IRQ fires
finish:
    ADDI N7, N0, 77          # word index 11, addr 0x2C
    HALT N7

.org 0x200
handler:
    MFCAUSE N3               # n3 = cause (expect 2 = external IRQ)
    MFEPC N4                 # n4 = epc (expect 0x28 - proves QMEASURE completed first)
    ADDI N5, N0, 0x2C        # n5 = finish's address (word index 11)
    MTEPC N5
    RFT
