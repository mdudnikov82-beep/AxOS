# AxISA v2.2 (see docs/ISA.md's PLAQ section): the plaquette
# P = (1/3) Re Tr(U1 U2 U3^dag U4^dag) of one lattice square. GENERATED by
# tools/gen_plaq_test.py - the expected bits in tb/tb_plaq.v come from its
# binary32 reference model. The testbench preloads the links into data
# memory (as a lattice loader would). Each P is STOREd to 0x300 + 4*i.

# cold lattice: every link = 1, P = 1 exactly
    ADDI N1, N0, 0x400
    PLAQ N2, N1
    STORE N2, N0, 0x300
# hot square: 4 dense random SU(3) links
    ADDI N1, N0, 0x600
    PLAQ N2, N1
    STORE N2, N0, 0x304
# the same square after a gauge transformation
    ADDI N1, N0, 0x800
    PLAQ N2, N1
    STORE N2, N0, 0x308
# warm square: links near 1
    ADDI N1, N0, 0xA00
    PLAQ N1, N1               # nd == ns: the base is read before nd is written
    STORE N1, N0, 0x30C
# U1 = U2 = U3 = U4 at the highest legal base: P = 1 up to rounding
    ADDI N1, N0, 0xEE0
    PLAQ N2, N1
    STORE N2, N0, 0x310
# illegal: misaligned base
    ADDI N1, N0, 0x602
    PLAQ N2, N1
# illegal: the 4 links would run into the UART window
    ADDI N1, N0, 0xEE4
    PLAQ N2, N1
# user mode: PLAQ reads physical memory, so it is kernel-only
    ADDI N1, N0, 0
    MTSMODE N1               # saved_mode = user
    ADDI N1, N0, 0x60   # = user_code
    MTEPC N1
    RFT
user_code:
    ADDI N1, N0, 0x600
    PLAQ N2, N1              # must trap: privilege violation (CAUSE 3)
    HALT N7                  # tohost = traps taken (expect 3)

.org 0x200
handler:
    MFCAUSE N3
    ADD N6, N6, N3           # n6 = sum of causes (expect 0+0+3 = 3)
    ADDI N7, N7, 1           # n7 = trap count
    MFEPC N5
    ADDI N5, N5, 4           # skip the trapping instruction
    MTEPC N5
    RFT
