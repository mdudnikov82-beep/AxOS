# AxISA v2.0 step 3 (see docs/ISA.md's "Quark flavor and hadrons"):
# BARYON QN / MESON QN build real hadrons from flavor codes and report
# their quantum numbers. GENERATED by tools/gen_hadrons_test.py - the
# expected values in tb/tb_hadrons.v come from that script's PDG quark
# table, not from the RTL. Each result is STOREd to 0x400+4k.
    ADDI N4, N0, 55          # sentinel - no illegal hadron may write it

# proton uud: Q=1 B=1 S=0 C=0 B'=0 T=0 2*I3=1
    ADDI R1, R0, UP
    ADDI G1, G0, UP
    ADDI B1, B0, DOWN
    BARYON QN, N1, R1, G1, B1
    STORE N1, N0, 0x400
# neutron udd: Q=0 B=1 S=0 C=0 B'=0 T=0 2*I3=-1
    ADDI R1, R0, UP
    ADDI G1, G0, DOWN
    ADDI B1, B0, DOWN
    BARYON QN, N1, R1, G1, B1
    STORE N1, N0, 0x404
# Delta++ uuu: Q=2 B=1 S=0 C=0 B'=0 T=0 2*I3=3
    ADDI R1, R0, UP
    ADDI G1, G0, UP
    ADDI B1, B0, UP
    BARYON QN, N1, R1, G1, B1
    STORE N1, N0, 0x408
# Omega- sss: Q=-1 B=1 S=-3 C=0 B'=0 T=0 2*I3=0
    ADDI R1, R0, STRANGE
    ADDI G1, G0, STRANGE
    ADDI B1, B0, STRANGE
    BARYON QN, N1, R1, G1, B1
    STORE N1, N0, 0x40C
# Lambda uds: Q=0 B=1 S=-1 C=0 B'=0 T=0 2*I3=0
    ADDI R1, R0, UP
    ADDI G1, G0, DOWN
    ADDI B1, B0, STRANGE
    BARYON QN, N1, R1, G1, B1
    STORE N1, N0, 0x410
# Lambda_c+ udc: Q=1 B=1 S=0 C=1 B'=0 T=0 2*I3=0
    ADDI R1, R0, UP
    ADDI G1, G0, DOWN
    ADDI B1, B0, CHARM
    BARYON QN, N1, R1, G1, B1
    STORE N1, N0, 0x414
# Lambda_b udb: Q=0 B=1 S=0 C=0 B'=-1 T=0 2*I3=0
    ADDI R1, R0, UP
    ADDI G1, G0, DOWN
    ADDI B1, B0, BOTTOM
    BARYON QN, N1, R1, G1, B1
    STORE N1, N0, 0x418
# antiproton: Q=-1 B=-1 S=0 C=0 B'=0 T=0 2*I3=-1
    ADDI R1, R0, -UP
    ADDI G1, G0, -UP
    ADDI B1, B0, -DOWN
    BARYON QN, N1, R1, G1, B1
    STORE N1, N0, 0x41C
# pi+ u dbar: Q=1 B=0 S=0 C=0 B'=0 T=0 2*I3=2
    ADDI R2, R0, UP
    ADDI R3, R0, -DOWN
    MESON QN, N1, R2, R3
    STORE N1, N0, 0x420
# pi- d ubar: Q=-1 B=0 S=0 C=0 B'=0 T=0 2*I3=-2
    ADDI R2, R0, DOWN
    ADDI R3, R0, -UP
    MESON QN, N1, R2, R3
    STORE N1, N0, 0x424
# K+ sbar u: Q=1 B=0 S=1 C=0 B'=0 T=0 2*I3=1
    ADDI R2, R0, -STRANGE
    ADDI R3, R0, UP
    MESON QN, N1, R2, R3
    STORE N1, N0, 0x428
# J/psi c cbar: Q=0 B=0 S=0 C=0 B'=0 T=0 2*I3=0
    ADDI R2, R0, CHARM
    ADDI R3, R0, -CHARM
    MESON QN, N1, R2, R3
    STORE N1, N0, 0x42C
# B+ u bbar: Q=1 B=0 S=0 C=0 B'=1 T=0 2*I3=1
    ADDI R2, R0, UP
    ADDI R3, R0, -BOTTOM
    MESON QN, N1, R2, R3
    STORE N1, N0, 0x430
# D0 c ubar: Q=0 B=0 S=0 C=1 B'=0 T=0 2*I3=-1
    ADDI R2, R0, CHARM
    ADDI R3, R0, -UP
    MESON QN, N1, R2, R3
    STORE N1, N0, 0x434
    STORE N0, N0, 0x438      # end marker slot stays 0
# illegal: BARYON QN, r = 7 (no 7th flavor)
    ADDI R1, R0, 7
    ADDI G1, G0, UP
    ADDI B1, B0, UP
    BARYON QN, N4, R1, G1, B1
# illegal: BARYON QN, g = 0 (not a quark)
    ADDI R1, R0, UP
    ADDI G1, G0, 0
    BARYON QN, N4, R1, G1, B1
# illegal: BARYON QN, b = -7
    ADDI G1, G0, UP
    ADDI B1, B0, -7
    BARYON QN, N4, R1, G1, B1
# illegal: BARYON QN, u u ubar (quarks + antiquark)
    ADDI B1, B0, -UP
    BARYON QN, N4, R1, G1, B1
# illegal: MESON QN, u d (two quarks)
    ADDI R2, R0, UP
    ADDI R3, R0, DOWN
    MESON QN, N4, R2, R3
# illegal: MESON QN, ubar dbar (two antiquarks)
    ADDI R2, R0, -UP
    ADDI R3, R0, -DOWN
    MESON QN, N4, R2, R3
# illegal: BARYON QN, t u d (top never hadronizes)
    ADDI R1, R0, TOP
    ADDI G1, G0, UP
    ADDI B1, B0, DOWN
    BARYON QN, N4, R1, G1, B1
# illegal: MESON QN, t tbar (top never hadronizes)
    ADDI R2, R0, TOP
    ADDI R3, R0, -TOP
    MESON QN, N4, R2, R3
# illegal: MESON QN, red u + green dbar (color octet)
    ADDI R2, R0, UP
    ADDI G2, G0, -DOWN
    .word 0x2504A000
    HALT N7                  # tohost = traps taken (expect 9)

.org 0x200
handler:
    MFCAUSE N3
    ADD N6, N6, N3           # n6 = sum of causes (expect 0 = all ILLEGAL)
    ADDI N7, N7, 1           # n7 = trap count
    MFEPC N5
    ADDI N5, N5, 4           # skip the bad instruction
    MTEPC N5
    RFT
