# AxISA v2.3 step 2: an external IRQ arriving while REUNIT runs (see
# tb/tb_trap_irq_reunit.v's +IRQ_PHASE: its first cycle, inside a square
# root, or its last write). The testbench preloads diag(2, 1, 1) at 0x80;
# REUNIT must turn it into the identity. In every phase the trap must wait
# until all 18 words are written: EPC = 0x28.
    ADDI N1, N0, 1
    MTSIE N1
    ADDI N1, N0, 1
    MTSMODE N1
    ADDI N1, N0, 0x1C       # continue's address (word index 7)
    MTEPC N1
    RFT

continue:
    ADDI N2, N0, 0x80        # word index 7, addr 0x1C - the matrix
    ADDI N3, N0, 0           # word index 8, addr 0x20 - (padding: keeps every address of the LINKMUL version)
    REUNIT N2                # word index 9, addr 0x24 - irq_in pulses inside
    ADDI N6, N0, 1           # word index 10, addr 0x28 - must NOT commit before the deferred IRQ fires
finish:
    ADDI N7, N0, 77          # word index 11, addr 0x2C
    HALT N7

.org 0x200
handler:
    MFCAUSE N3               # n3 = cause (expect 2 = external IRQ)
    MFEPC N4                 # n4 = epc (expect 0x28 - proves REUNIT completed first)
    ADDI N5, N0, 0x2C        # n5 = finish's address (word index 11)
    MTEPC N5
    RFT
