# AxISA v2.0 step 4 (see docs/ISA.md's STRING section): asymptotic
# freedom. GENERATED by tools/gen_string_test.py - the expected results
# and cycle counts in tb/tb_string.v come from that script's reference
# model, not from the RTL. Each STRING is followed by a STORE so the
# testbench can time every STRING separately (it counts the cycles
# is_string stays high).
    ADDI N4, N0, 55          # sentinel - the illegal STRING may not write it

# same place: no string: d=0x0, 1 cycles
    ADDI R1, R0, 5
    ADDI R2, R0, 5
    STRING N1, R1, R2
    STORE N1, N0, 0x400
# d=1: d=0x1, 2 cycles
    ADDI R1, R0, 7
    ADDI R2, R0, 6
    STRING N1, R1, R2
    STORE N1, N0, 0x404
# d=5, reversed order: d=0x5, 4 cycles
    ADDI G1, G0, 3
    ADDI G2, G0, 8
    STRING N1, G1, G2
    STORE N1, N0, 0x408
# d=1000: d=0x3e8, 11 cycles
    ADDI B1, B0, 1000
    ADDI B2, B0, 0
    STRING N1, B1, B2
    STORE N1, N0, 0x40C
# d=0x7FFF, 15 bits: d=0x7fff, 16 cycles
    ADDI R1, R0, 0
    ADDI R2, R0, 1
    SLLI R2, R2, 15
    ADDI R2, R2, -1
    STRING N1, R1, R2
    STORE N1, N0, 0x410
# d=0xFFFF, longest unbroken string: d=0xffff, 17 cycles
    ADDI R1, R0, 0
    ADDI R2, R0, 1
    SLLI R2, R2, 16
    ADDI R2, R2, -1
    STRING N1, R1, R2
    STORE N1, N0, 0x414
# d=2^16: first break, 1 pair: d=0x10000, 17 cycles
    ADDI R1, R0, 1
    SLLI R1, R1, 16
    ADDI R2, R0, 0
    STRING N1, R1, R2
    STORE N1, N0, 0x418
# 3 pairs + a 5-long segment: d=0x30005, 17 cycles
    ADDI G1, G0, 3
    SLLI G1, G1, 16
    ORI G1, G1, 5
    ADDI G2, G0, 0
    STRING N1, G1, G2
    STORE N1, N0, 0x41C
# negative position: d=0xfa, 9 cycles
    ADDI B1, B0, -100
    ADDI B2, B0, 150
    STRING N1, B1, B2
    STORE N1, N0, 0x420
# d=2^32-1, the widest: d=0xffffffff, 17 cycles
    ADDI R1, R0, -1
    SRLI R1, R1, 1
    ADDI R2, R0, 1
    SLLI R2, R2, 31
    STRING N1, R1, R2
    STORE N1, N0, 0x424
    STORE N0, N0, 0x428      # end marker slot stays 0
    .word 0x8CCA0000         # STRING N4, N1, N2 - N is colorless, no string
    HALT N7                  # tohost = traps taken (expect 1)

.org 0x200
handler:
    MFCAUSE N3
    ADD N6, N6, N3           # n6 = sum of causes (expect 0 = ILLEGAL)
    ADDI N7, N7, 1           # n7 = trap count
    MFEPC N5
    ADDI N5, N5, 4           # skip the bad instruction
    MTEPC N5
    RFT
