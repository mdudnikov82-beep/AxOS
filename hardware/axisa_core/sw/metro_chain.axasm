# AxISA v2.2 step 2: a real Metropolis Markov chain on the processor.
# GENERATED by tools/gen_metro_test.py. One link U1 of a lattice square
# can be any of 8 SU(3) matrices (the testbench preloads the 8 squares
# [C_m, U2, U3, U4] at 0x400 + 0x120*m). The program measures every
# square's plaquette with PLAQ into a table, then runs 3000 Metropolis
# steps at beta = 6.0: propose m' = m +- 1 (mod 8) with a fair coin,
# accept with METRO, count where the chain is. Detailed balance makes the
# histogram Boltzmann's exp(-beta (1 - P_m)) - tb/tb_metro_chain.v checks.
#
# n1 = 4*m   n2 = P_m   n6 = steps left   n3/n4/n5/n7 = scratch
# constants: 0x380 = ln 2, +4 = 1.0, +8 = beta

    ADDI N1, N0, 0x400
    PLAQ N2, N1
    STORE N2, N0, 0x300
    ADDI N1, N0, 0x520
    PLAQ N2, N1
    STORE N2, N0, 0x304
    ADDI N1, N0, 0x640
    PLAQ N2, N1
    STORE N2, N0, 0x308
    ADDI N1, N0, 0x760
    PLAQ N2, N1
    STORE N2, N0, 0x30C
    ADDI N1, N0, 0x880
    PLAQ N2, N1
    STORE N2, N0, 0x310
    ADDI N1, N0, 0x9A0
    PLAQ N2, N1
    STORE N2, N0, 0x314
    ADDI N1, N0, 0xAC0
    PLAQ N2, N1
    STORE N2, N0, 0x318
    ADDI N1, N0, 0xBE0
    PLAQ N2, N1
    STORE N2, N0, 0x31C
    ADDI N1, N0, 0               # start in square 0
    LOAD N2, N0, 0x300
    ADDI N6, N0, 3000
step:
    LOAD N3, N0, 0x380       # coin: dS = 1.0 * (ln 2 - 0), w = 1/2
    LOAD N4, N0, 0x384
    METRO ACCEPT, N5, N3, N0, N4
    ADDI N7, N1, 4               # heads: m + 1
    BNE N5, N0, picked
    ADDI N7, N1, -4              # tails: m - 1
picked:
    ANDI N7, N7, 0x1C            # mod 8
    LOAD N3, N7, 0x300          # P_new
    LOAD N4, N0, 0x388       # beta
    METRO ACCEPT, N5, N2, N3, N4
    BEQ N5, N0, stay
    ADDI N1, N7, 0               # accepted: move
    ADDI N2, N3, 0
stay:
    LOAD N3, N1, 0x340
    ADDI N3, N3, 1
    STORE N3, N1, 0x340
    ADDI N6, N6, -1
    BNE N6, N0, step
    HALT N0
