# AxISA v2.3 step 3 (see docs/ISA.md's SWEEP section): the average
# plaquette of a whole periodic L x L lattice in ONE instruction.
# GENERATED by tools/gen_sweep_test.py - expected bits in tb/tb_sweep.v
# come from its binary32 model. <P> values are STOREd from 0x3E0.
# a hot 4x4 lattice
    ADDI N1, N0, 0x400
    SWEEP N2, N1, 4
    STORE N2, N0, 0x3E0
# a warm 2x2 lattice
    ADDI N1, N0, 0x100
    SWEEP N1, N1, 2            # nd == ns
    STORE N1, N0, 0x3E4
# a cold 1x1 lattice: <P> = 1 exactly
    ADDI N1, N0, 0xD00
    SWEEP N2, N1, 1
    STORE N2, N0, 0x3E8
# illegal: misaligned, and a 4x4 lattice (2304 bytes) that would run into the UART window
    ADDI N1, N0, 0x402
    SWEEP N2, N1, 2
    ADDI N1, N0, 0x800
    SWEEP N2, N1, 4
# user mode: SWEEP reads physical memory, so it is kernel-only
    ADDI N1, N0, 0
    MTSMODE N1               # saved_mode = user
    ADDI N1, N0, 0x48   # = user_code
    MTEPC N1
    RFT
user_code:
    ADDI N1, N0, 0x100
    SWEEP N2, N1, 2          # must trap: privilege violation (CAUSE 3)
    HALT N7                  # tohost = traps taken (expect 3)

.org 0x200
handler:
    MFCAUSE N5
    ADD N6, N6, N5           # n6 = sum of causes (expect 0+0+3 = 3)
    ADDI N7, N7, 1           # n7 = trap count
    MFEPC N5
    ADDI N5, N5, 4           # skip the trapping instruction
    MTEPC N5
    RFT
