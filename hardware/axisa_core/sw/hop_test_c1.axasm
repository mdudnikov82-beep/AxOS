# AxISA v2.3 step 4: core 1 = (x 1, y 0) of a 2x2 torus. GENERATED by
# tools/gen_hop_test.py (see it for the plan); tb/tb_hop.v checks memory.
# 1. a word in every direction, then one from every direction
    ADDI N1, N0, 0x110
    HOP SEND +X, N1
    ADDI N1, N0, 0x111
    HOP SEND -X, N1
    ADDI N1, N0, 0x112
    HOP SEND +Y, N1
    ADDI N1, N0, 0x113
    HOP SEND -Y, N1
    HOP RECV N2, +X
    STORE N2, N0, 0x300
    HOP RECV N2, -X
    STORE N2, N0, 0x304
    HOP RECV N2, +Y
    STORE N2, N0, 0x308
    HOP RECV N2, -Y
    STORE N2, N0, 0x30C
# 2. back-pressure
# 3. swap SU(3) links with the x neighbour, then multiply them
    ADDI N1, N0, 0x400
    ADDI N3, N0, 0x480
    HOP RECVL -X, N3
    HOP SENDL +X, N1
    ADDI N4, N0, 0x500
    LINKMUL N4, N1, N3   # own link x the neighbour's
# 4. a RECV that really has to wait: core 3 sends late
    HOP RECV N2, +Y      # waits for core 3
    STORE N2, N0, 0x320
# 5. traps: a misaligned link, one running into the UART window, user mode
    ADDI N1, N0, 0x402
    HOP SENDL +X, N1
    ADDI N1, N0, 0xFBC
    HOP RECVL -X, N1
    ADDI N1, N0, 0
    MTSMODE N1               # saved_mode = user
    ADDI N1, N0, 0x84   # = user_code
    MTEPC N1
    RFT
user_code:
    ADDI N1, N0, 0x400
    HOP SENDL +X, N1         # must trap: privilege violation (CAUSE 3)
    HALT N7                  # tohost = traps taken (expect 3)

.org 0x200
handler:
    MFCAUSE N5
    ADD N6, N6, N5           # n6 = sum of causes (expect 0+0+3 = 3)
    ADDI N7, N7, 1           # n7 = trap count
    MFEPC N5
    ADDI N5, N5, 4           # skip the trapping instruction
    MTEPC N5
    RFT
