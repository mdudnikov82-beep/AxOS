# AxISA v2.3 step 4: core 0 = (x 0, y 0) of a 2x2 torus. GENERATED by
# tools/gen_hop_test.py (see it for the plan); tb/tb_hop.v checks memory.
# 1. a word in every direction, then one from every direction
    ADDI N1, N0, 0x100
    HOP SEND +X, N1
    ADDI N1, N0, 0x101
    HOP SEND -X, N1
    ADDI N1, N0, 0x102
    HOP SEND +Y, N1
    ADDI N1, N0, 0x103
    HOP SEND -Y, N1
    HOP RECV N2, +X
    STORE N2, N0, 0x300
    HOP RECV N2, -X
    STORE N2, N0, 0x304
    HOP RECV N2, +Y
    STORE N2, N0, 0x308
    HOP RECV N2, -Y
    STORE N2, N0, 0x30C
# 2. back-pressure
    ADDI N1, N0, 0xA1
    HOP SEND +Y, N1     # the 2nd and 3rd wait for core 2
    ADDI N1, N0, 0xA2
    HOP SEND +Y, N1     # the 2nd and 3rd wait for core 2
    ADDI N1, N0, 0xA3
    HOP SEND +Y, N1     # the 2nd and 3rd wait for core 2
# 3. swap SU(3) links with the x neighbour, then multiply them
    ADDI N1, N0, 0x400
    ADDI N3, N0, 0x480
    HOP SENDL +X, N1
    HOP RECVL -X, N3
    ADDI N4, N0, 0x500
    LINKMUL N4, N1, N3   # own link x the neighbour's
# 4. a RECV that really has to wait: core 3 sends late
    HALT N0
