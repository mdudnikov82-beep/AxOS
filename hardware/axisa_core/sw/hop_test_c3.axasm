# AxISA v2.3 step 4: core 3 = (x 1, y 1) of a 2x2 torus. GENERATED by
# tools/gen_hop_test.py (see it for the plan); tb/tb_hop.v checks memory.
# 1. a word in every direction, then one from every direction
    ADDI N1, N0, 0x130
    HOP SEND +X, N1
    ADDI N1, N0, 0x131
    HOP SEND -X, N1
    ADDI N1, N0, 0x132
    HOP SEND +Y, N1
    ADDI N1, N0, 0x133
    HOP SEND -Y, N1
    HOP RECV N2, +X
    STORE N2, N0, 0x300
    HOP RECV N2, -X
    STORE N2, N0, 0x304
    HOP RECV N2, +Y
    STORE N2, N0, 0x308
    HOP RECV N2, -Y
    STORE N2, N0, 0x30C
# 2. back-pressure
# 3. swap SU(3) links with the x neighbour, then multiply them
    ADDI N1, N0, 0x400
    ADDI N3, N0, 0x480
    HOP RECVL -X, N3
    HOP SENDL +X, N1
    ADDI N4, N0, 0x500
    LINKMUL N4, N1, N3   # own link x the neighbour's
# 4. a RECV that really has to wait: core 3 sends late
    ADDI N3, N0, 80
late:
    ADDI N3, N3, -1
    BNE N3, N0, late
    ADDI N1, N0, 0x5A5
    HOP SEND -Y, N1      # into core 1's +y mailbox
    HALT N0
