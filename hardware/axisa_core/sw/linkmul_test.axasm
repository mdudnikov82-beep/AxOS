# AxISA v2.3 step 1 (see docs/ISA.md's LINKMUL section): C = A' B' for
# 3x3 complex matrices in memory. GENERATED by tools/gen_linkmul_test.py -
# the expected words in tb/tb_linkmul.v come from its binary32 model. The
# testbench preloads A at 0x400, B at 0x480 (and at 0xFB8), X at 0x500.

# C = A B
    ADDI N1, N0, 0x400
    ADDI N2, N0, 0x480
    ADDI N3, N0, 0x600
    LINKMUL N3, N1, N2
# C = A^dag B
    ADDI N1, N0, 0x400
    ADDI N2, N0, 0x480
    ADDI N3, N0, 0x680
    LINKMUL N3, N1^, N2
# C = A B^dag
    ADDI N1, N0, 0x400
    ADDI N2, N0, 0x480
    ADDI N3, N0, 0x700
    LINKMUL N3, N1, N2^
# C = A^dag A: unitarity, ~ identity
    ADDI N1, N0, 0x400
    ADDI N2, N0, 0x400
    ADDI N3, N0, 0x780
    LINKMUL N3, N1^, N2
# C = B^dag A^dag (= (A B)^dag)
    ADDI N1, N0, 0x480
    ADDI N2, N0, 0x400
    ADDI N3, N0, 0x800
    LINKMUL N3, N1^, N2^
# in place, C == B: the Metropolis proposal U <- X U
    ADDI N1, N0, 0x500
    ADDI N2, N0, 0x480
    ADDI N3, N0, 0x480
    LINKMUL N3, N1, N2
# in place, C == A: A <- A X^dag
    ADDI N1, N0, 0x400
    ADDI N2, N0, 0x500
    ADDI N3, N0, 0x400
    LINKMUL N3, N1, N2^
# A at the highest legal base
    ADDI N1, N0, 0xFB8
    ADDI N2, N0, 0x400
    ADDI N3, N0, 0x880
    LINKMUL N3, N1, N2
# illegal: a misaligned A, a B and a C that would run into the UART window
    ADDI N1, N0, 0x402
    LINKMUL N3, N1, N2
    ADDI N1, N0, 0x400
    ADDI N2, N0, 0xFBC
    LINKMUL N3, N1, N2
    ADDI N2, N0, 0x480
    ADDI N3, N0, 0xFC0
    LINKMUL N3, N1, N2
# user mode: LINKMUL reads and writes physical memory, so it is kernel-only
    ADDI N1, N0, 0
    MTSMODE N1               # saved_mode = user
    ADDI N1, N0, 0xB4   # = user_code
    MTEPC N1
    RFT
user_code:
    ADDI N1, N0, 0x400
    ADDI N3, N0, 0x900
    LINKMUL N3, N1, N2       # must trap: privilege violation (CAUSE 3)
    HALT N7                  # tohost = traps taken (expect 4)

.org 0x200
handler:
    MFCAUSE N5
    ADD N6, N6, N5           # n6 = sum of causes (expect 0+0+0+3 = 3)
    ADDI N7, N7, 1           # n7 = trap count
    MFEPC N5
    ADDI N5, N5, 4           # skip the trapping instruction
    MTEPC N5
    RFT
