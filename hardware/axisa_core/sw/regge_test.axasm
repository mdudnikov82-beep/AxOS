# AxISA v2.1 step 3 (see docs/ISA.md's REGGE section): string theory's
# origin - hadrons on straight Regge trajectories, J = a0 + a' M^2, as a
# rotating relativistic string predicts. GENERATED by
# tools/gen_regge_test.py: the expected bits in tb/tb_regge.v come from
# its binary32 reference model, and that script checks the physics
# (real PDG hadron spins/masses) before writing anything.

# rho(770)    -> J = 1: 0.775 -> 1.0406
    ADDI N1, N0, 506
    SLLI N1, N1, 11
    ORI N1, N1, 409
    SLLI N1, N1, 10
    ORI N1, N1, 614
    REGGE SPIN.M, N2, N1
    STORE N2, N0, 0x400
# a2(1320)    -> J = 2: 1.3183 -> 2.0641
    ADDI N1, N0, 509
    SLLI N1, N1, 11
    ORI N1, N1, 559
    SLLI N1, N1, 10
    ORI N1, N1, 526
    REGGE SPIN.M, N2, N1
    STORE N2, N0, 0x404
# rho3(1690)  -> J = 3: 1.6888 -> 3.0668
    ADDI N1, N0, 510
    SLLI N1, N1, 11
    ORI N1, N1, 1546
    SLLI N1, N1, 10
    ORI N1, N1, 665
    REGGE SPIN.M, N2, N1
    STORE N2, N0, 0x408
# a4(1970)    -> J = 4: 1.967 -> 3.9822
    ADDI N1, N0, 511
    SLLI N1, N1, 11
    ORI N1, N1, 1777
    SLLI N1, N1, 10
    ORI N1, N1, 680
    REGGE SPIN.M, N2, N1
    STORE N2, N0, 0x40C
# Delta(1232) -> J = 3/2: 1.232 -> 1.5160
    ADDI N1, N0, 508
    SLLI N1, N1, 11
    ORI N1, N1, 1900
    SLLI N1, N1, 10
    ORI N1, N1, 557
    REGGE SPIN.B, N2, N1
    STORE N2, N0, 0x410
# Delta(1950) -> J = 7/2: 1.93 -> 3.5024
    ADDI N1, N0, 511
    SLLI N1, N1, 11
    ORI N1, N1, 1474
    SLLI N1, N1, 10
    ORI N1, N1, 573
    REGGE SPIN.B, N2, N1
    STORE N2, N0, 0x414
# Delta(2420) -> J = 11/2: 2.42 -> 5.4208
    ADDI N1, N0, 512
    SLLI N1, N1, 11
    ORI N1, N1, 1720
    SLLI N1, N1, 10
    ORI N1, N1, 328
    REGGE SPIN.B, N2, N1
    STORE N2, N0, 0x418
# J = 1 meson -> rho mass: 1 -> 0.7454
    ADDI N1, N0, 508
    SLLI N1, N1, 11
    ORI N1, N1, 0
    SLLI N1, N1, 10
    ORI N1, N1, 0
    REGGE MASS.M, N2, N1
    STORE N2, N0, 0x41C
# J = 5 meson -> rho5(2350): 5 -> 2.2361
    ADDI N1, N0, 517
    SLLI N1, N1, 11
    ORI N1, N1, 0
    SLLI N1, N1, 10
    ORI N1, N1, 0
    REGGE MASS.M, N2, N1
    STORE N2, N0, 0x420
# J = 3/2 baryon -> Delta(1232): 1.5 -> 1.2247
    ADDI N1, N0, 510
    SLLI N1, N1, 11
    ORI N1, N1, 0
    SLLI N1, N1, 10
    ORI N1, N1, 0
    REGGE MASS.B, N2, N1
    STORE N2, N0, 0x424
# J = 0 is below the intercept: no real mass (NaN): 0 -> nan
    ADDI N1, N0, 0
    SLLI N1, N1, 11
    ORI N1, N1, 0
    SLLI N1, N1, 10
    ORI N1, N1, 0
    REGGE MASS.M, N2, N1
    STORE N2, N0, 0x428
# nd == ns (in place)
    ADDI N3, N0, 510
    SLLI N3, N3, 11
    ORI N3, N3, 1546
    SLLI N3, N3, 10
    ORI N3, N3, 665
    REGGE SPIN.M, N3, N3
    HALT N3                  # tohost = J of rho3(1690)
