# AxISA mini-kernel, LOOPING variant: same real UART shell as
# mini_shell.axasm (read -> recognize "hi" -> act), but instead of
# HALTing after one command it branches back to re-print the prompt
# and accept another command forever - meant to be the permanent,
# always-on program for a real silicon build (Tiny Tapeout), where
# there is no host to notice a HALT and restart the core.
#
# Exactly two differences from mini_shell.axasm:
#   1. `shell_loop:` label added right before the buffer-offset reset,
#      so the prompt-print + read loop become the loop body. N1 (UART
#      base) and N4 (command buffer base) are set once and never
#      rewritten, so they stay OUTSIDE the loop.
#   2. The final `HALT N6` is replaced with an unconditional branch
#      back to `shell_loop:`.
#
# Verified safe register-by-register: N2/N5/N6 are always (re)written
# before they're read on every single pass through the loop body
# (prompt, echo, match, and no-match arms all rewrite them fresh
# first); N3 (buffer write offset) is explicitly reset at the top of
# every loop iteration; the command buffer at 0x1100 is simply
# overwritten by the next line's bytes, which is exactly the intended
# "discard old command, accept new one" behavior.
#
# KNOWN, DELIBERATE CONSEQUENCE: since HALT is never reached, `halted`
# and `tohost_value` stay at their reset value (0) for the entire life
# of this bitstream. That is expected - not a bug, not a sign the core
# is stuck - it's what "loop forever" means. Do not mistake a
# permanently-low `halted` pin on real hardware for a malfunction.
#
# KNOWN, PRE-EXISTING LIMITATION (inherited from mini_shell.axasm,
# now live on an always-running device instead of a one-shot test):
# the buffer write offset N3 has no bounds check. An unrealistically
# long line typed before CR/LF would walk N3 past the private
# data_mem's real size with no fault (AxISA v0.1 has no
# alignment/bounds fault checking - see data_mem.v's own header
# comment). Not fixed here; low real-world risk with a human typist.
    ADDI N1, N0, 0x1000    # n1 = UART base (set once, never changes)
    ADDI N4, N0, 0x1100    # n4 = command buffer base (set once, never changes)

shell_loop:
    ADDI N3, N0, 0         # n3 = buffer write offset - RESET every iteration

    # print prompt "> "
    ADDI N2, N0, 62        # '>'
    STORE N2, N1, 0
    ADDI N2, N0, 32        # ' '
    STORE N2, N1, 0

readloop:
    LOAD N5, N1, 8         # n5 = ready flag
    BEQ  N5, N0, readloop  # busy-wait for a byte (same idiom as shared_consumer.axasm)
    LOAD N2, N1, 4         # n2 = received byte
    STORE N0, N1, 8        # ack/clear ready (value stored doesn't matter, only that a STORE happened)
    STORE N2, N1, 0        # echo it back - a real terminal expects this

    ADDI N5, N0, 13        # CR
    BEQ  N2, N5, gotline
    ADDI N5, N0, 10        # LF
    BEQ  N2, N5, gotline

    ADD  N5, N4, N3        # n5 = buffer_base + offset
    STORE N2, N5, 0        # store this char into the command buffer
    ADDI N3, N3, 4         # advance offset by one word
    BEQ  N0, N0, readloop  # unconditional - keep reading (n0 always equals n0)

gotline:
    ADDI N6, N0, 8
    BNE  N3, N6, nomatch   # must be exactly 2 characters ("hi") - 2*4=8 bytes of offset

    LOAD N5, N4, 0         # first char
    ADDI N2, N0, 104       # 'h'
    BNE  N5, N2, nomatch
    LOAD N5, N4, 4         # second char
    ADDI N2, N0, 105       # 'i'
    BNE  N5, N2, nomatch

    # matched - print "OK\r\n"
    ADDI N2, N0, 79        # 'O'
    STORE N2, N1, 0
    ADDI N2, N0, 75        # 'K'
    STORE N2, N1, 0
    ADDI N2, N0, 13
    STORE N2, N1, 0
    ADDI N2, N0, 10
    STORE N2, N1, 0
    BEQ  N0, N0, shell_loop

nomatch:
    ADDI N2, N0, 63        # '?'
    STORE N2, N1, 0
    ADDI N2, N0, 13
    STORE N2, N1, 0
    ADDI N2, N0, 10
    STORE N2, N1, 0
    BEQ  N0, N0, shell_loop  # loop forever: reprint prompt, accept another command
