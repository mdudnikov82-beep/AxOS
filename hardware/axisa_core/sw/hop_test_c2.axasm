# AxISA v2.3 step 4: core 2 = (x 0, y 1) of a 2x2 torus. GENERATED by
# tools/gen_hop_test.py (see it for the plan); tb/tb_hop.v checks memory.
# 1. a word in every direction, then one from every direction
    ADDI N1, N0, 0x120
    HOP SEND +X, N1
    ADDI N1, N0, 0x121
    HOP SEND -X, N1
    ADDI N1, N0, 0x122
    HOP SEND +Y, N1
    ADDI N1, N0, 0x123
    HOP SEND -Y, N1
    HOP RECV N2, +X
    STORE N2, N0, 0x300
    HOP RECV N2, -X
    STORE N2, N0, 0x304
    HOP RECV N2, +Y
    STORE N2, N0, 0x308
    HOP RECV N2, -Y
    STORE N2, N0, 0x30C
# 2. back-pressure
    ADDI N3, N0, 60
dawdle:
    ADDI N3, N3, -1
    BNE N3, N0, dawdle
    HOP RECV N2, -Y
    STORE N2, N0, 0x310
    HOP RECV N2, -Y
    STORE N2, N0, 0x314
    HOP RECV N2, -Y
    STORE N2, N0, 0x318
# 3. swap SU(3) links with the x neighbour, then multiply them
    ADDI N1, N0, 0x400
    ADDI N3, N0, 0x480
    HOP SENDL +X, N1
    HOP RECVL -X, N3
    ADDI N4, N0, 0x500
    LINKMUL N4, N1, N3   # own link x the neighbour's
# 4. a RECV that really has to wait: core 3 sends late
    HALT N0
