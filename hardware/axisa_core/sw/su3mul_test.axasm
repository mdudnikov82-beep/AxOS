# AxISA v2.0 step 5 (see docs/ISA.md's SU3MUL section): psi' = U * psi
# with real SU(3) matrices. GENERATED by tools/gen_su3mul_test.py - the
# expected bits in tb/tb_su3mul.v come from its binary32 reference
# model. The testbench preloads the matrices into data memory (as a
# lattice loader would); psi has to be built with immediates because
# confinement forbids moving anything from N/memory into R/G/B.

# psi at pair 0
    ADDI R0, R0, 504
    SLLI R0, R0, 11
    ORI R0, R0, 0
    SLLI R0, R0, 10
    ORI R0, R0, 0
    ADDI R1, R0, 1524
    SLLI R1, R1, 11
    ORI R1, R1, 0
    SLLI R1, R1, 10
    ORI R1, R1, 0
    ADDI G0, G0, 511
    SLLI G0, G0, 11
    ORI G0, G0, 0
    SLLI G0, G0, 10
    ORI G0, G0, 0
    ADDI G1, G0, 496
    SLLI G1, G1, 11
    ORI G1, G1, 0
    SLLI G1, G1, 10
    ORI G1, G1, 0
    ADDI B0, B0, 1531
    SLLI B0, B0, 11
    ORI B0, B0, 0
    SLLI B0, B0, 10
    ORI B0, B0, 0
    ADDI B1, B0, 513
    SLLI B1, B1, 11
    ORI B1, B1, 0
    SLLI B1, B1, 10
    ORI B1, B1, 0
# psi at pair 6
    ADDI R6, R0, 1534
    SLLI R6, R6, 11
    ORI R6, R6, 0
    SLLI R6, R6, 10
    ORI R6, R6, 0
    ADDI R7, R0, 500
    SLLI R7, R7, 11
    ORI R7, R7, 1638
    SLLI R7, R7, 10
    ORI R7, R7, 410
    ADDI G6, G0, 504
    SLLI G6, G6, 11
    ORI G6, G6, 1638
    SLLI G6, G6, 10
    ORI G6, G6, 410
    ADDI G7, G0, 1536
    SLLI G7, G7, 11
    ORI G7, G7, 1024
    SLLI G7, G7, 10
    ORI G7, G7, 0
    ADDI B6, B0, 508
    SLLI B6, B6, 11
    ORI B6, B6, 819
    SLLI B6, B6, 10
    ORI B6, B6, 205
    ADDI B7, B0, 507
    SLLI B7, B7, 11
    ORI B7, B7, 409
    SLLI B7, B7, 10
    ORI B7, B7, 614
# identity at the highest legal base: psi' = psi
    ADDI N1, N0, 0xFB8
    SU3MUL N1, 2, 0
# dense SU(3) M1
    ADDI N1, N0, 0x400
    SU3MUL N1, 4, 0
# M2 in place (dst == src)
    ADDI N1, N0, 0x500
    SU3MUL N1, 6, 6
# M1 applied again to pair 4: chained M1*M1*psiA
    ADDI N1, N0, 0x400
    SU3MUL N1, 0, 4
# illegal: dst = 7 has no Im partner
    ADDI N0, N0, 0           # NOP: keeps the testbench's per-SU3MUL cycle count from merging
    .word 0x91E00000         # SU3MUL N1, 7, 0
# illegal: misaligned matrix base 0x402
    ADDI N1, N0, 0x402
    SU3MUL N1, 4, 0
# illegal: matrix would run into the UART window (base 0xFBC)
    ADDI N1, N0, 0xFBC
    SU3MUL N1, 4, 0
# user mode: SU3MUL reads physical memory, so it is kernel-only
    ADDI N1, N0, 0
    MTSMODE N1               # saved_mode = user
    ADDI N1, N0, 0x13C   # = user_code
    MTEPC N1
    RFT
user_code:
    ADDI N1, N0, 0x400
    SU3MUL N1, 4, 0          # must trap: privilege violation (CAUSE 3)
    HALT N7                  # tohost = traps taken (expect 4)

.org 0x200
handler:
    MFCAUSE N3
    ADD N6, N6, N3           # n6 = sum of causes (expect 0+0+0+3 = 3)
    ADDI N7, N7, 1           # n7 = trap count
    MFEPC N5
    ADDI N5, N5, 4           # skip the trapping instruction
    MTEPC N5
    RFT
