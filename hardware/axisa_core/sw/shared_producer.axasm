# AxISA cross-core producer: writes a payload then a ready flag into
# shared memory (flag published LAST - the consumer must never see a
# ready flag before the payload it guards is actually there).
    ADDI N1, N0, 0x2000   # n1 = shared base
    ADDI N2, N0, 77       # payload
    STORE N2, N1, 4       # mem[0x2004] = 77
    ADDI N3, N0, 1        # ready flag value
    STORE N3, N1, 0       # mem[0x2000] = 1 (published LAST)
    HALT N2               # tohost = 77
